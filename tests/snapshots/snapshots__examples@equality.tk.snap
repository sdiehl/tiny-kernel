theorem zero_eq : Eq Nat zero zero := refl Nat zero
theorem one_eq : Eq Nat (succ zero) (succ zero) := refl Nat (succ zero)
theorem id_eq : (A : Type) -> (a : A) -> Eq A a a := fun (A : Type) => fun (a : A) => refl A a
