theorem id_thm : (A : Type) -> A -> A := fun (A : Type) => fun (x : A) => x
theorem const_thm : (A : Type) -> (B : Type) -> A -> B -> A := fun (A : Type) => fun (B : Type) => fun (a : A) => fun (b : B) => a
axiom imp : (A : Type) -> (B : Type) -> A -> B
theorem use_apply : (A : Type) -> (B : Type) -> A -> B := fun (A : Type) => fun (B : Type) => fun (a : A) => imp A B a
